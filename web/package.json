{
  "name": "pawtrace-web",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "pawtrace's front end on densk-core, built into src/pawtrace/webui/app/ (served by `pawtrace serve`)",
  "workspaces": ["densk-core"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
